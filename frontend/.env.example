# URL base de la API puente (FastAPI) para el tablero.
VITE_API_URL=http://localhost:8000

# URL de la instancia de n8n (Local o Cloud)
VITE_N8N_URL=http://localhost:5678

# Usar webhook de prueba (/webhook-test/) o producción (/webhook/)
# True: útil mientras se depura con el botón 'Listen for test event' en n8n
# False: para workflows activados en producción
VITE_N8N_USE_TEST_WEBHOOK=true
