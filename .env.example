# ==========================================================
# HSE Email Automation - Plantilla de variables de entorno
# ----------------------------------------------------------
# Instrucciones:
#   1. Copia este archivo como ".env":  cp .env.example .env
#   2. Cambia las contraseñas y claves API por valores reales.
#   3. No subas el archivo ".env" a Git.
# ==========================================================

# ----------------------------------------------------------
# 1. PostgreSQL auto-hospedado (docker-compose.yml)
# ----------------------------------------------------------
POSTGRES_USER=hse_admin
POSTGRES_PASSWORD=cambia_esta_contrasena_en_produccion
POSTGRES_DB=hse_email_automation
POSTGRES_PORT=5432
TZ=America/Bogota

# ----------------------------------------------------------
# 2. Conexión para el frontend
# ----------------------------------------------------------
DATABASE_URL=postgresql://hse_admin:cambia_esta_contrasena_en_produccion@localhost:5432/hse_email_automation?schema=public
DIRECT_URL=postgresql://hse_admin:cambia_esta_contrasena_en_produccion@localhost:5432/hse_email_automation?schema=public

# ----------------------------------------------------------
# 3. Conexión para n8n (nodo Postgres)
# ----------------------------------------------------------
# Fuera de Docker -> host=localhost. Dentro de Docker -> host=postgres.
N8N_POSTGRES_HOST=localhost
N8N_POSTGRES_PORT=5432
N8N_POSTGRES_DB=hse_email_automation
N8N_POSTGRES_USER=hse_admin
N8N_POSTGRES_PASSWORD=cambia_esta_contrasena_en_produccion
N8N_POSTGRES_URL=postgresql://hse_admin:cambia_esta_contrasena_en_produccion@localhost:5432/hse_email_automation

# ----------------------------------------------------------
# 4. Configuración propia de n8n
# ----------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/

# ----------------------------------------------------------
# 5. Motor de IA (Strata Core / Gemini / OpenAI)
# ----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional-fallback

# ----------------------------------------------------------
# 6. Microsoft Outlook (Graph API)
# ----------------------------------------------------------
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ----------------------------------------------------------
# 7. Google Workspace / Gmail API
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=your-redirect-uri
