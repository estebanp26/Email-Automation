# ==========================================================
# HSE Email Automation - Plantilla de variables de entorno
# ----------------------------------------------------------
# Instrucciones:
#   1. Copia este archivo como ".env":  cp .env.example .env
#   2. Cambia las contraseñas y claves API por valores reales.
#   3. No subas el archivo ".env" a Git.
# ==========================================================

# ----------------------------------------------------------
# 1. PostgreSQL (Base de datos HSE)
# ----------------------------------------------------------
POSTGRES_USER=hse_admin
POSTGRES_PASSWORD=cambia_esta_contrasena_en_produccion
POSTGRES_DB=hse_email_automation
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
TZ=America/Bogota

# Conexión directa / Prisma / SQL
DATABASE_URL=postgresql://hse_admin:cambia_esta_contrasena_en_produccion@localhost:5432/hse_email_automation?schema=public
DIRECT_URL=postgresql://hse_admin:cambia_esta_contrasena_en_produccion@localhost:5432/hse_email_automation?schema=public

# ----------------------------------------------------------
# 2. API Backend Nativa (FastAPI)
# ----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
INBOUND_EMAIL_ENDPOINT=/api/v1/inbound-email
INBOUND_API_URL=http://localhost:8001/api/v1/inbound-email
INBOUND_API_KEY=riwi-hse-inbound-secret-key-2026
INBOUND_HMAC_SECRET=riwi-hse-hmac-sha256-signature-secret

# ----------------------------------------------------------
# 3. Motor de IA (Strata Core / Ollama / Gemini / OpenAI)
# ----------------------------------------------------------
STRATA_CORE_HOST=0.0.0.0
STRATA_CORE_PORT=8001
STRATA_CORE_URL=http://localhost:8001
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional-fallback

# ----------------------------------------------------------
# 4. CONN-01: Microsoft Outlook & Azure AD Graph API
# ----------------------------------------------------------
OUTLOOK_MAILBOX=hse@riwi.io
OUTLOOK_TENANT_ID=your-azure-tenant-id
OUTLOOK_CLIENT_ID=your-azure-client-id
OUTLOOK_CLIENT_SECRET=your-azure-client-secret
# Compatibilidad con variables AZURE_*
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
# Acceso directo IMAP4 (Alternativa sin Azure App)
OUTLOOK_USER=hse@riwi.io
OUTLOOK_PASSWORD=your-app-password
OUTLOOK_HOST=outlook.office365.com
OUTLOOK_PORT=993

# ----------------------------------------------------------
# 5. CONN-02 & CONN-03: Google Cloud Pub/Sub & Gmail API
# ----------------------------------------------------------
GMAIL_MAILBOX=hse@riwi.io
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_PUBSUB_PROJECT_ID=riwi-email-automation
GOOGLE_PUBSUB_TOPIC=projects/riwi-email-automation/topics/gmail-incoming
GOOGLE_PUBSUB_SUBSCRIPTION=projects/riwi-email-automation/subscriptions/gmail-incoming-sub

# ----------------------------------------------------------
# 6. CONN-04: Servidor SMTP / Envío de Correos
# ----------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hse@riwi.io
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Bienestar HSE Riwi <hse@riwi.io>
SMTP_USE_TLS=true
SMTP_DEFAULT_PROVIDER=SMTP # Opciones: SMTP, GRAPH, GMAIL

# ----------------------------------------------------------
# 7. CONN-03: API de Asistencia Plataforma Hermana (Sister Platform)
# ----------------------------------------------------------
SISTER_PLATFORM_API_URL=https://api.plataforma-hermana.riwi.io/v1
SISTER_PLATFORM_API_KEY=riwi-sister-mock-key-dev
SISTER_PLATFORM_USE_MOCK=true

