                <mxCell id="justifications" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;strokeWidth=1.5;align=left;verticalAlign=top;spacing=4;" value="&lt;table border=&quot;0&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;font-family:Arial,sans-serif;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; bgcolor=&quot;#D9EAD3&quot; style=&quot;font-weight:bold;text-align:center;font-size:14px;border-bottom:1px solid #9ca3af;&quot;&gt;justifications&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Campo&lt;/td&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Tipo&lt;/td&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Clave / Nota&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;id&lt;/td&gt;&lt;td&gt;UUID&lt;/td&gt;&lt;td&gt;🔑 PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;coder_id&lt;/td&gt;&lt;td&gt;UUID&lt;/td&gt;&lt;td&gt;🔗 FK → coders.id · NULL si no identificado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hse_user_id&lt;/td&gt;&lt;td&gt;UUID&lt;/td&gt;&lt;td&gt;🔗 FK → hse_users.id · NULL hasta intervención&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sender_email&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;Correo recibido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sender_name&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;Puede ser NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email_subject&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Asunto original&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email_body&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Cuerpo original&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email_url&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Enlace directo al correo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;message_id&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;conversation_id&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;Conversación Outlook&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;intent&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;RETRASO, EXCUSA, etc.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;excuse_type&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;Médica, laboral, etc.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;start_date&lt;/td&gt;&lt;td&gt;DATE&lt;/td&gt;&lt;td&gt;Inicio; si no indica duración, fecha del correo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;end_date&lt;/td&gt;&lt;td&gt;DATE&lt;/td&gt;&lt;td&gt;Fin de la excusa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ai_confidence&lt;/td&gt;&lt;td&gt;NUMERIC(5,4)&lt;/td&gt;&lt;td&gt;Confianza de Qwen 2.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ai_reason&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Razón resumida visible en frontend&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ai_response&lt;/td&gt;&lt;td&gt;JSONB&lt;/td&gt;&lt;td&gt;Respuesta estructurada completa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ai_model&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;Ej. Qwen 2.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;coder_identification_status&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;IDENTIFIED / CODER_NOT_FOUND&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;validation_status&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;APPROVED / DISAPPROVED / MANUAL_INTERACTION&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;validation_notes&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Observaciones del proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hse_decision&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;APPROVED / DISAPPROVED / REQUEST_CORRECTION&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hse_notes&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Notas de HSE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hse_reviewed_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;NULL hasta revisión&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;attachments&lt;/td&gt;&lt;td&gt;JSONB&lt;/td&gt;&lt;td&gt;NULL · archivos y análisis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;received_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;Fecha/hora del correo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;Orden cronológico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updated_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;Auditoría&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="820" width="650" x="500" y="590" as="geometry"/>
