                <mxCell id="coders" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;strokeWidth=1.5;align=left;verticalAlign=top;spacing=4;" value="&lt;table border=&quot;0&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;font-family:Arial,sans-serif;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; bgcolor=&quot;#F4CCCC&quot; style=&quot;font-weight:bold;text-align:center;font-size:14px;border-bottom:1px solid #9ca3af;&quot;&gt;coders&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Campo&lt;/td&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Tipo&lt;/td&gt;&lt;td style=&quot;font-weight:bold;border-bottom:1px solid #d1d5db;&quot;&gt;Clave / Nota&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;id&lt;/td&gt;&lt;td&gt;UUID&lt;/td&gt;&lt;td&gt;🔑 PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;cedula&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;Requerido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;email&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;UNIQUE · Requerido&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;route&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;Ruta del coder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;is_active&lt;/td&gt;&lt;td&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;Estado actual&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;Auditoría&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;updated_at&lt;/td&gt;&lt;td&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td&gt;Auditoría&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
