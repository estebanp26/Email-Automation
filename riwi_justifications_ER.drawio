                <mxCell id="rel_coders_just" edge="1" parent="1" source="coders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=ERone;startArrow=ERmany;" target="justifications" value="1:N · coders.id → justifications.coder_id">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rel_hse_just" edge="1" parent="1" source="hse_users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=ERone;startArrow=ERmany;" target="justifications" value="0..1:N · hse_users.id → justifications.hse_user_id">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="design_notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;DECISIONES DE DISEÑO&lt;/b&gt;&lt;br&gt;• Un único historial en &lt;b&gt;justifications&lt;/b&gt;.&lt;br&gt;• El frontend filtra por &lt;b&gt;validation_status&lt;/b&gt;: Válidas, No válidas, Intervención HSE.&lt;br&gt;• &lt;b&gt;coder_id&lt;/b&gt; puede ser NULL cuando se muestra Coder_no_encontrado.&lt;br&gt;• &lt;b&gt;start_date / end_date&lt;/b&gt; se almacenan; los días se calculan.&lt;br&gt;• &lt;b&gt;ai_response JSONB&lt;/b&gt; conserva la salida de Qwen 2.5.&lt;br&gt;• &lt;b&gt;attachments JSONB&lt;/b&gt; es opcional.&lt;br&gt;• Se eliminan &lt;b&gt;hse_system_config&lt;/b&gt; y &lt;b&gt;email_templates&lt;/b&gt; del modelo de BD; reglas y HTML viven en n8n." vertex="1">
                    <mxGeometry height="300" width="390" x="60" y="750" as="geometry"/>
                </mxCell>
                <mxCell id="frontend_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;FRONTEND HSE&lt;/b&gt;&lt;br&gt;Listado ordenado por fecha/hora · filtros de estado · búsqueda de coder · razón resumida de IA · enlace al correo original · intervención y solicitud de corrección." vertex="1">
                    <mxGeometry height="170" width="300" x="1170" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;RELACIONES&lt;/b&gt;&lt;br&gt;coders 1 ─── N justifications&lt;br&gt;hse_users 0..1 ─── N justifications&lt;br&gt;&lt;br&gt;&lt;b&gt;Importante:&lt;/b&gt; una justificación permanece en el mismo registro. No se mueve entre tablas para cambiar su estado." vertex="1">
                    <mxGeometry height="190" width="300" x="1170" y="810" as="geometry"/>
                </mxCell>
