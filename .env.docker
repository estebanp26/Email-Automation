# ==========================================================
# HSE Email Automation - Variables de entorno para Docker
# ----------------------------------------------------------
# Copia este archivo a .env para levantar todo en Docker:
#   cp .env.docker .env
# ==========================================================

# ----------------------------------------------------------
# 1. PostgreSQL (Base de datos HSE)
# ----------------------------------------------------------
POSTGRES_USER=hse_admin
POSTGRES_PASSWORD=hse_segura_123
POSTGRES_DB=hse_email_automation
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
TZ=America/Bogota

DATABASE_URL=postgresql://hse_admin:hse_segura_123@postgres:5432/hse_email_automation

# ----------------------------------------------------------
# 2. APIs y Servicios Internos
# ----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
STRATA_CORE_URL=http://strata-core:8001
INBOUND_API_URL=http://strata-core:8001/api/v1/inbound-email
INBOUND_API_KEY=riwi-hse-inbound-secret-key-2026

# ----------------------------------------------------------
# 3. Modelos de IA
# ----------------------------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----------------------------------------------------------
# 4. Frontend & n8n
# ----------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_N8N_URL=http://localhost:5678
VITE_N8N_USE_TEST_WEBHOOK=true

# ----------------------------------------------------------
# 5. Gmail Live Listener (Worker)
# ----------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ----------------------------------------------------------
# 6. Alertas Discord / Slack
# ----------------------------------------------------------
HSE_DISCORD_WEBHOOK_URL=

# ----------------------------------------------------------
# 7. Plataforma Hermana
# ----------------------------------------------------------
SISTER_PLATFORM_API_URL=https://api.plataforma-hermana.riwi.io/v1
SISTER_PLATFORM_API_KEY=
SISTER_PLATFORM_USE_MOCK=true
